# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建产物 ----------
dist/
src-tauri/target/
# gen/ 由 tauri 的 build.rs 从 capabilities 自动生成
src-tauri/gen/

# ---------- 本地运行数据（绝不提交）----------
# 设置里的 API key 走 Windows 凭据管理器，但配置文件本身仍属本地数据
src-tauri/data/
*.db
*.db-journal
*.db-wal
*.db-shm
settings.json

# ---------- 模型文件 ----------
# 权重动辄 GB，且上游下载常被墙，不进仓库
llama/
models/
*.gguf

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 日志与临时文件 ----------
*.log
npm-debug.log*
*.tmp
*.bak
*.orig
*.rej
.cache/

# ---------- 调试截图与工具产物 ----------
# screenshot.ps1 / Playwright MCP 每次运行都会覆盖，属本地临时产物
*.exe
scripts/*.png
.playwright-mcp/
.claude/
.zcode/
.vite/
.turbo/

# ---------- 编辑器与系统 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ---------- Rust ----------
**/*.rs.bk