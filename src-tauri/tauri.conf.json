{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hy-MT2 翻译工具",
  "version": "0.1.0",
  "identifier": "com.hymt2.translator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hy-MT2 翻译工具",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}