{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zephyr-translator",
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "longDescription": "跨端桌面 AI 翻译工具，可接入任意 OpenAI 兼容端点。Rust 侧只负责界面宿主与 IO（配置、凭据、HTTP、文档解析）；翻译推理由本地 llama-server 或任意 OpenAI 兼容云端接口完成。支持 6 种翻译模式、术语库、历史、批量与文档翻译。",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/desktop.template"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
