{
  "name": "hy-mt2-translator",
  "version": "0.1.0",
  "private": true,
  "description": "Hy-MT2 跨端翻译工具 (Vue 3 + Rust / Tauri)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint:format": "prettier --write --loglevel warn \"src/**/*.{ts,vue,css,json}\"",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@lucide/vue": "^1.56.0",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "vue": "3.5.12"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}